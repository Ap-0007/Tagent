# Tagent — environment configuration

# ----- API Gateway -----
API_GATEWAY_PORT=8080

# ----- Discovery Service -----
DISCOVERY_PORT=8081
KUBECONFIG=~/.kube/config

# ----- Monitoring Service -----
MONITORING_PORT=8082
PROMETHEUS_URL=http://localhost:9090

# ----- AI Engine (LOCAL MODELS ONLY — no cloud APIs) -----
AI_ENGINE_PORT=8083
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ----- Remediation Service -----
REMEDIATION_PORT=8084
REMEDIATION_MODE=read-only  # read-only | approval-required | auto

# ----- Notification Service -----
NOTIFICATION_PORT=8085
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----- Documentation Service -----
DOCUMENTATION_PORT=8086

# ----- Database -----
DATABASE_URL=postgresql://tagent:password@localhost:5432/tagent

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Kafka -----
KAFKA_BROKERS=localhost:9092
