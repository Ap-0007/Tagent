# Tagent — environment configuration

# ----- API Gateway -----
API_GATEWAY_PORT=8080

# ----- Discovery Service -----
DISCOVERY_PORT=8081
KUBECONFIG=~/.kube/config

# ----- Monitoring Service -----
MONITORING_PORT=8082
PROMETHEUS_URL=http://localhost:9090

# ----- AI Engine (LOCAL MODELS ONLY — no cloud APIs) -----
AI_ENGINE_PORT=8083
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ----- Remediation Service -----
REMEDIATION_PORT=8084
REMEDIATION_MODE=read-only  # read-only | approval-required | auto

# ----- Notification Service -----
NOTIFICATION_PORT=8085
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----- Documentation Service -----
DOCUMENTATION_PORT=8086

# ----- Database -----
DATABASE_URL=postgresql://tagent:password@localhost:5432/tagent

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Kafka -----
KAFKA_BROKERS=localhost:9092

# ----- Integrations -----
# Slack (OAuth Bot Token or Webhook)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL is already above

# Microsoft Teams (Incoming Webhook)
TEAMS_WEBHOOK_URL=

# PagerDuty
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
PAGERDUTY_INTEGRATION_KEY=

# Opsgenie
OPSGENIE_API_KEY=
OPSGENIE_TEAM_ID=

# Twilio (SMS/Voice alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBERS=

# Custom Webhooks
WEBHOOK_ENDPOINTS=
WEBHOOK_SECRET=

# Jira (Incident ticket creation)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# GitHub (Deployment tracking, issue creation)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# GitLab (Deployment tracking, issue creation)
GITLAB_TOKEN=
GITLAB_BASE_URL=
GITLAB_PROJECT_ID=

# ----- Escalation Chain -----
ESCALATION_ENABLED=false
ESCALATION_PHONE_DELAY_MIN=3
ESCALATION_AUTO_FIX_DELAY_MIN=10
ESCALATION_QUIET_START=22:00
ESCALATION_QUIET_END=06:00
ESCALATION_MIN_SEVERITY=high
ESCALATION_SLACK_USER=@oncall
ESCALATION_SECONDARY_PHONE=
ESCALATION_SECONDARY_EMAIL=
